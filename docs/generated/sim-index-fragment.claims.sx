  (primary [row Route(RouteRecord { id: RouteId("route/transform-signal"), title: "Transform a real or complex signal", audiences: ["code", "framework", "user"], steps: [Feature { id: FeatureId("feature/sim-numbers/tensors"), why: "The tensor row owns canonical complex and f64 storage shared by signal inputs and outputs." }, Feature { id: FeatureId("feature/sim-numbers/signal-transforms"), why: "The signal row owns explicit transform conventions, direct references, fast Fourier plans, typed convolution/correlation geometry, guarded spectral inverse, strided tensor axes, bounded blocks, and execution reports." }, Specimen { id: SpecimenId("spec-test/sim-numbers/crates/sim-lib-numbers-signal/src/conformance"), why: "The checked one-dimensional specimen proves impulse and tone bins, orthonormal Parseval and round trips, prime-length coverage, and fail-closed inputs." }, Specimen { id: SpecimenId("spec-test/sim-numbers/crates/sim-lib-numbers-signal/src/multidimensional_tests"), why: "The checked multidimensional specimen proves strided direct-definition agreement, scratch admission, stable plan evidence, and blocked/in-memory equality." }, Specimen { id: SpecimenId("spec-test/sim-numbers/crates/sim-lib-numbers-signal/src/convolution_tests"), why: "The checked convolution specimen proves direct/FFT agreement, overlap-add/save equality and reports, correlation symmetry, identity/commutativity, and finite guarded deconvolution diagnostics." }, Specimen { id: SpecimenId("recipe/sim-numbers/crates/sim-lib-numbers-signal/01-basics/convolution-evidence"), why: "The checked Lisp specimen exposes automatic convolution cost selection beside the retained result." }], doc_anchor: None })] [note "route/transform-signal"] [section "route"])
